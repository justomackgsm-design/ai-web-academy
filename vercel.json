{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "_server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|assets|favicon|uploads|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
