# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL (Neon) Connection String for secure durable data persistence.
DATABASE_URL=

# MONEROO_SECRET_KEY: Secret key for Moneroo payment processing.
MONEROO_SECRET_KEY=

# EXCHANGE_RATE_API_KEY: API key for currency conversion (ExchangeRate-API).
EXCHANGE_RATE_API_KEY=

# BLOB_READ_WRITE_TOKEN: Vercel Blob token for secure and permanent cloud video file storage.
BLOB_READ_WRITE_TOKEN=


# CLOUDINARY: stockage vidéo (upload direct navigateur -> Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ADMIN_PASSWORD : mot de passe d'accès à l'interface administrateur.
# OBLIGATOIRE — il n'existe plus aucun mot de passe par défaut dans le code.
ADMIN_PASSWORD=

# MASTER_ACCESS_CODE : code d'accès maître (facultatif) créé automatiquement
# au premier démarrage. Laissez vide si vous gérez vos codes depuis l'admin.
MASTER_ACCESS_CODE=
